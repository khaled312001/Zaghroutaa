// ==========================================================
//  زُغْرُوطَة — مخطط قاعدة البيانات (MySQL)
// ==========================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// تصنيفات المنتجات (بصمات، مرايات، بوكيهات، مناديل ...)
model Category {
  id       Int       @id @default(autoincrement())
  slug     String    @unique
  nameAr   String
  emoji    String?
  order    Int       @default(0)
  products Product[]
}

/// المنتج (قطعة منفردة أو باكدج)
model Product {
  id            Int              @id @default(autoincrement())
  slug          String           @unique
  nameAr        String
  shortAr       String?          @db.Text
  descriptionAr String?          @db.Text
  basePrice     Int
  oldPrice      Int?
  categoryId    Int?
  category      Category?        @relation(fields: [categoryId], references: [id])
  coverImage    String
  isPackage     Boolean          @default(false)
  isFeatured    Boolean          @default(false)
  isActive      Boolean          @default(true)
  badge         String?
  order         Int              @default(0)
  images        ProductImage[]
  variants      ProductVariant[]
  orders        Order[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

/// صور المنتج (جاليري)
model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  order     Int     @default(0)

  @@index([productId])
}

/// خيارات المنتج (مثال: العريس بس / الاتنين مع بعض / بالريش)
model ProductVariant {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  nameAr    String
  price     Int
  oldPrice  Int?
  order     Int     @default(0)

  @@index([productId])
}

/// طلب الحجز اللي بييجي من العروسة
model Order {
  id           Int         @id @default(autoincrement())
  productId    Int?
  product      Product?    @relation(fields: [productId], references: [id])
  productName  String
  variantName  String?
  price        Int?
  customerName String
  phone        String
  governorate  String
  address      String      @db.Text
  groomName    String?
  brideName    String?
  eventType    String? // كتب كتاب / فرح
  eventDate    DateTime?
  notes        String?     @db.Text
  status       OrderStatus @default(NEW)
  createdAt    DateTime    @default(now())
  images       OrderImage[]

  // --- نظام التنبيهات الذكي ---
  readyByDate  DateTime? // آخر ميعاد لازم القطعة تكون خلصت فيه (للتسليم/الشحن)
  priorityBump Int       @default(0) // رفع أولوية يدوي من إيمان
  remindersOn  Boolean   @default(true) // تفعيل/إيقاف تنبيهات الأوردر ده
  reminders     Reminder[]
  shoppingItems ShoppingItem[]

  // --- كود الخصم ---
  couponCode   String? // الكود اللي استخدمته العروسة (لو فيه)

  @@index([productId])
  @@index([status])
  @@index([readyByDate])
}

/// طابور رسائل الواتساب (Outbox) — الموقع بيكتب فيه، والـ worker بيبعت منه
model Reminder {
  id          Int       @id @default(autoincrement())
  orderId     Int?
  order       Order?    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind        String    @default("custom") // due_soon | followup | materials | digest | custom
  title       String
  body        String    @db.Text
  toNumber    String // الرقم اللي بيستقبل التنبيه (رقم الشغل)
  priority    Int       @default(0)
  scheduledAt DateTime // ميعاد الإرسال
  sentAt      DateTime?
  status      String    @default("PENDING") // PENDING | SENT | FAILED | CANCELLED
  attempts    Int       @default(0)
  error       String?   @db.Text
  dedupeKey   String?   @unique // يمنع تكرار نفس التذكير
  createdAt   DateTime  @default(now())

  @@index([status, scheduledAt])
  @@index([orderId])
}

/// أكواد الخصم (بتتحكم فيها إيمان: تفعيل/إيقاف + مواسم + حد استخدام)
model Coupon {
  id         Int       @id @default(autoincrement())
  code       String    @unique
  percent    Int       @default(10) // نسبة الخصم %
  active     Boolean   @default(true)
  startsAt   DateTime? // بداية الموسم (اختياري)
  endsAt     DateTime? // نهاية الموسم (اختياري)
  usageLimit Int? // أقصى عدد استخدام (اختياري)
  usedCount  Int       @default(0)
  note       String? // ملاحظة لإيمان (مثلاً: حملة رمضان)
  createdAt  DateTime  @default(now())
}

/// قائمة الخامات اللي محتاجة تتشتري
model ShoppingItem {
  id        Int      @id @default(autoincrement())
  orderId   Int?
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  name      String
  qty       String?
  bought    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([orderId])
}

/// صور مرفقة بالطلب (صورة مرجعية من العميلة)
model OrderImage {
  id        Int      @id @default(autoincrement())
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  url       String
  createdAt DateTime @default(now())

  @@index([orderId])
}

enum OrderStatus {
  NEW
  CONTACTED
  CONFIRMED
  EMBROIDERING
  PACKING
  SHIPPING
  DONE
  CANCELLED
}

/// آراء العملاء (سكرين شوت + نص اختياري)
model Review {
  id        Int      @id @default(autoincrement())
  imageUrl  String
  name      String?
  text      String?  @db.Text
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

/// إعدادات الموقع (رقم الواتساب، السوشيال، نص الديبوزت ...)
model Setting {
  key   String @id
  value String @db.Text
}

/// حساب الأدمن (إيمان)
model AdminUser {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

/// صور معرض الأعمال (سابقة الأعمال)
model GalleryItem {
  id        Int      @id @default(autoincrement())
  imageUrl  String
  title     String?
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

/// محتوى ديناميكي للصفحات (نصوص، روابط، صور)
model Content {
  key       String   @id
  value     String   @db.Text
  type      String   @default("text") // text, image, rich
  groupAr   String?
  labelAr   String?
  order     Int      @default(0)
  updatedAt DateTime @updatedAt
}
