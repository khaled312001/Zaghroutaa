# ====== زُغْرُوطَة — متغيرات البيئة ======
# انسخ الملف ده باسم .env.local على جهازك (أو .env على السيرفر) واملا القيم

# --- قاعدة البيانات MySQL ---
# الصيغة: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# على هوستنجر هتلاقي البيانات دي في لوحة التحكم > Databases
DATABASE_URL="mysql://root:password@localhost:3306/zaghroutaa"

# --- سر تسجيل دخول الأدمن (لازم يكون طويل وعشوائي) ---
# اعمل واحد جديد بالأمر: openssl rand -base64 32
AUTH_SECRET="change-this-to-a-long-random-string-please"

# --- بيانات حساب الأدمن (إيمان) — بتتزرع في الداتابيز عند تشغيل seed ---
ADMIN_NAME="إيمان"
ADMIN_EMAIL="eman@zaghroutaa.com"
ADMIN_PASSWORD="ChangeMe@2026"

# --- رقم الواتساب اللي بيتحوّل عليه الحجز (بمفتاح الدولة من غير + أو مسافات) ---
# مثال لمصر: 201001234567  — ممكن تغيّره كمان من لوحة الأدمن > الإعدادات
NEXT_PUBLIC_WHATSAPP_NUMBER="201000000000"

# --- رابط الموقع (للـ SEO و canonical) ---
NEXT_PUBLIC_SITE_URL="https://zaghroutaa.com"
