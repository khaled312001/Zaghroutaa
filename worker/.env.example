# رابط الموقع
SITE_URL=https://zaghroutaa.com

# نفس التوكن السري اللي على الموقع (WA_WORKER_TOKEN) — لازم يكونوا متطابقين
WA_WORKER_TOKEN=ضع_توكن_سري_طويل_وعشوائي_هنا

# اسم جلسة الواتساب (سيبيه زي ما هو)
SESSION_NAME=zaghroutaa

# كل كام ثانية يسأل الموقع عن تذكيرات جديدة
POLL_SECONDS=60

# مسافة بالملي ثانية بين كل رسالة والتانية (تفادي السبام)
SEND_GAP_MS=4000
